# ── Public runtime configuration ─────────────────────────────────────────────
# Canonical public URL of the deployment (no trailing slash).
# In production this must be the real origin; localhost is rejected at build.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ذكر
NEXT_PUBLIC_APP_VERSION=N/A
# Set to "true" to show verbose errors in the UI. Always "false" in production.
NEXT_PUBLIC_DEBUG=false
# Search Console HTML verification token (optional).
GOOGLE_SITE_VERIFICATION=
# Force noindex on preview/staging builds. Production stays false.
SEO_NOINDEX=false

# Feature flags (default off unless explicitly enabled).
NEXT_PUBLIC_ENABLE_MP3QURAN_V4=false
NEXT_PUBLIC_ENABLE_FOLLOW_ALONG=false

# ── Server configuration ─────────────────────────────────────────────────────
# Port used by `next start` / the standalone server.
PORT=3000

# ── Contact form ─────────────────────────────────────────────────────────────
# Sent through the server's own mail (src/lib/site-mail.ts) to CONTACT_TO, or the first
# of ADMIN_EMAILS. EMAIL_DEV_LOG=1 prints instead of sending (development).
CONTACT_TO=

# ── Itqan CMS API ────────────────────────────────────────────────────────────
# Optional server-only key. Public endpoints work without it, but the key
# raises limits and identifies the app in `X-Itqan-App`.
ITQAN_API_KEY=

# ── Quran Foundation provider ────────────────────────────────────────────────
# OAuth2 client credentials (server-only; never expose the secret to the client).
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
# Public read-only fallback used when the credentials above are absent.
QURAN_FOUNDATION_PUBLIC_API_BASE=https://api.quran.com/api/v4

# ── MP3Quran v4 beta ────────────────────────────────────────────────────────
# Staging base URL until the v4 API is promoted. Override per environment.
MP3QURAN_V4_BASE_URL=https://api-staging.mp3quran.net/v4

# ── Accounts, keys and the admin page (optional) ─────────────────────────────
# Postgres; run `node scripts/migrate.mjs` once. Without it the account pages and the
# keyed API (/api/v1) are off; listening and reading still work.
DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
ADMIN_EMAILS=
# Print sign-in links and contact messages instead of sending mail (development).
EMAIL_DEV_LOG=1

# ── Content on disk (optional) ───────────────────────────────────────────────
# Library, hadith, tafsir, encyclopedia and PDFs, synced from the apps' content
# (default: .content in the project, in the apps' layout: app/assets/data/…).
CONTENT_ROOT=
QURANPEDIA_ROOT=
# The Libyan prayer tables (github.com/Jawad18750/libya-prayer-times).
PRAYER_ROOT=
# Whole-recitation downloads read from disk when set.
AUDIO_ROOT=

# ── The printed mushaf (private service) ─────────────────────────────────────
# Ayah and surah-name pictures come from a separate service that is not part of this
# repository. Without it their places stay empty and everything else works.
READER_URL=
READER_TOKEN=
READER_SESSION_SECRET=

# ── Listening numbers (optional) ─────────────────────────────────────────────
CF_ANALYTICS_TOKEN=
CF_ANALYTICS_ZONE=
